<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %> — Threads Deleter</title>
		<link rel="stylesheet" href="/fonts/index.css" />
		<link rel="stylesheet" href="/style.css" />
		<script>
			const hasError = "<%= error ? 'true' : '' %>";
			if (hasError) {
				sessionStorage.clear();
			} else if (sessionStorage.getItem('threads_token')) {
				window.location.href = '/dashboard';
			}
		</script>
		<style>
			body {
				opacity: 0;
				transition: opacity 0.2s;
			}
			body.ready {
				opacity: 1;
			}
		</style>
	</head>
	<body class="ready">
		<div class="container">
			<header>
				<h1>Threads Deleter</h1>
				<p>Manage your Threads content</p>
			</header>

			<% if (error) { %>
				<div class="alert alert-error"><%= error %></div>
			<% } %>

			<div class="card">
				<h2>Login with Threads</h2>
				<p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem">
					Sign in with your Threads account via OAuth.
				</p>
				<a href="/auth/login" class="btn btn-primary">Authorize with Threads</a>

				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--text-muted);">
					<p style="margin-bottom: 0.5rem">This tool is in private testing.</p>
					<a href="https://github.com/dstN/threadsDeleter/issues" target="_blank" style="color: var(--text-muted); text-decoration: underline;">Open a GitHub Issue</a> to request access.
				</div>
			</div>

			<footer>
				Threads Deleter &mdash; Use responsibly
				<br />
				<a href="/privacy" style="color: var(--text-muted); text-decoration: none; margin-right: 1rem"
					>Privacy Policy</a
				>
				<a href="/tos" style="color: var(--text-muted); text-decoration: none">Terms of Service</a>
			</footer>
		</div>
	</body>
</html>
