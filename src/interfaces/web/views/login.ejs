<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %> — Threads Deleter</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script>
			if (sessionStorage.getItem('threads_token')) {
				window.location.href = '/dashboard';
			}
		</script>
		<style>
			body {
				opacity: 0;
				transition: opacity 0.2s;
			}
			body.ready {
				opacity: 1;
			}
		</style>
	</head>
	<body class="ready">
		<div class="container">
			<header>
				<h1>Threads Deleter</h1>
				<p>Manage your Threads content</p>
			</header>

			<!-- Manual Token Input (Hidden for Web Dashboard, CLI only) -->
			<!--
    <div class="card">
      <h2>Login with Access Token</h2>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form action="/auth/token" method="POST">
        <label for="token">Threads Access Token</label>
        <input type="password" id="token" name="token" placeholder="Paste your long-lived access token" required>
        <button type="submit" class="btn btn-primary">Connect</button>
      </form>
    </div>

    <div class="divider">or</div>
    -->

			<div class="card">
				<h2>Login with Threads</h2>
				<p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem">
					Sign in with your Threads account via OAuth.
				</p>
				<a href="/auth/login" class="btn btn-outline">Authorize with Threads</a>
			</div>

			<footer>
				Threads Deleter &mdash; Use responsibly
				<br />
				<a href="/privacy" style="color: var(--text-muted); text-decoration: none; margin-right: 1rem"
					>Privacy Policy</a
				>
				<a href="/tos" style="color: var(--text-muted); text-decoration: none">Terms of Service</a>
			</footer>
		</div>
	</body>
</html>
