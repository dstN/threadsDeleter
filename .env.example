# ──────────────────────────────────────────────────────────────
# Threads Deleter – Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The CLI does NOT read .env automatically — pass --token directly
# or source the file before invoking the tool.
# ──────────────────────────────────────────────────────────────

# Long-lived Threads access token (60-day expiry)
# Required scopes: threads_basic, threads_delete
THREADS_ACCESS_TOKEN=your_access_token_here

# (Optional) Your Threads numeric User ID
THREADS_USER_ID=
