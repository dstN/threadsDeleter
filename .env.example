# ─── Required ─────────────────────────────────────────────────
# Your long-lived Threads access token
THREADS_ACCESS_TOKEN=

# ─── OAuth 2.0 (optional — only for OAuth mode) ──────────────
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Web server ───────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-random-secret

# ─── Environment ──────────────────────────────────────────────
NODE_ENV=development
