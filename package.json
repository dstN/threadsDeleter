{
  "name": "threads-deleter",
  "version": "2.1.0",
  "description": "Enterprise-grade CLI & web tool to delete posts and replies from your Threads profile via the official Threads API.",
  "main": "src/app.js",
  "bin": {
    "threads-deleter": "./src/interfaces/cli/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node -r dotenv/config src/interfaces/cli/cli.js",
    "start:web": "node -r dotenv/config src/interfaces/web/server.js",
    "dry-run": "node -r dotenv/config src/interfaces/cli/cli.js --dry-run --verbose",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --verbose",
    "check": "node --check src/interfaces/cli/cli.js && node --check src/interfaces/web/server.js && node --check src/app.js"
  },
  "keywords": [
    "threads",
    "meta",
    "api",
    "cli",
    "web",
    "delete",
    "replies",
    "posts",
    "social-media",
    "automation",
    "oauth"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "^3.8.1"
  }
}
